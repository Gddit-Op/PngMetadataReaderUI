<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:viewModels="clr-namespace:PngMetadataReaderUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PngMetadataReaderUI.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Avalonia Image Drag &amp; Drop"
        Width="800" Height="600">

    <Design.DataContext>
        <viewModels:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings"
                          Click="SettingsMenuItem_Click"/>
                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1" 
                   Text="Avalonia Image Drag &amp; Drop"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,10"/>
        
        <Border Grid.Row="2"
                Name="DropZone"
                Margin="20"
                BorderBrush="Gray"
                BorderThickness="2"
                DragDrop.AllowDrop="True"
                PointerWheelChanged="DropZone_PointerWheelChanged"
                Background="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}, ConverterParameter=Transparent, FallbackValue=LightGray}">
            <Grid>
                <TextBlock Text="Drop image (PNG/JPG/WebP) here"
                           IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="DarkGray"/>

                <ScrollViewer Margin="10"
                              x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              SizeChanged="ImageScrollViewer_SizeChanged"
                              IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <controls:LayoutTransformControl HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                        <controls:LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ImageZoom}"
                                            ScaleY="{Binding ImageZoom}"/>
                        </controls:LayoutTransformControl.LayoutTransform>
                        <Image Source="{Binding Image}"
                               Stretch="None"/>
                    </controls:LayoutTransformControl>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <StackPanel Grid.Row="3" 
                    Orientation="Vertical"
                    Margin="20,0,20,20">
            <TextBlock Text="{Binding StatusMessage}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <Button Content="Browse for Image..." 
                        Click="BrowseButton_Click"/>

                <Button Content="Bildbeschreibung Prompt"
                        Command="{Binding GeneratePromptCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,12,0,0">
                <TextBlock Text="{Binding ImageZoom, StringFormat='Zoom: {0:P0}'}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button Content="Zoom -"
                        Command="{Binding ZoomOutCommand}"/>
                <Button Content="Zoom +"
                        Command="{Binding ZoomInCommand}"/>
                <Button Content="Reset Zoom"
                        Command="{Binding ResetZoomCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
